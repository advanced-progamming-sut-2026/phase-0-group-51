+    // TEST STARTING: model tile references and graphical bounds
+    private void runBoardConnectionTest() {
+        int testedTiles = 0;
+
+        for (int lane = 0; lane < board.getLaneCount(); lane++) {
+            for (int column = 0; column < board.getColumnCount(); column++) {
+                Tile modelTile = board.getTile(lane, column);
+                TileView tileView = tileViews[lane][column];
+
+                if (tileView == null) {
+                    throw new IllegalStateException(
+                            "Board test failed: missing TileView at lane="
+                                    + lane
+                                    + ", column="
+                                    + column
+                    );
+                }
+
+                if (tileView.getTile() != modelTile) {
+                    throw new IllegalStateException(
+                            "Board test failed: TileView is not connected to the model Tile at lane="
+                                    + lane
+                                    + ", column="
+                                    + column
+                    );
+                }
+
+                float expectedX = transform.tileX(column);
+                float expectedY = transform.tileY(lane);
+                float expectedWidth = transform.tileWidth();
+                float expectedHeight = transform.tileHeight();
+
+                float epsilon = 0.01f;
+
+                if (Math.abs(tileView.getX() - expectedX) > epsilon
+                        || Math.abs(tileView.getY() - expectedY) > epsilon
+                        || Math.abs(tileView.getWidth() - expectedWidth) > epsilon
+                        || Math.abs(tileView.getHeight() - expectedHeight) > epsilon) {
+                    throw new IllegalStateException(
+                            "Board test failed: wrong graphical bounds at lane="
+                                    + lane
+                                    + ", column="
+                                    + column
+                    );
+                }
+
+                testedTiles++;
+            }
+        }
+
+        System.out.println(
+                "[BOARD TEST PASS] "
+                        + testedTiles
+                        + " graphical tiles are connected to their model tiles with correct bounds."
+        );
+    }
+    // TEST ENDING: model tile references and graphical bounds
